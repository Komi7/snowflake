{ pkgs, ... }:
{
  programs.waybar = {
    enable = true;
    systemd.enable = true;
    settings = {
      mainBar = {
        layer = "top";
        position = "top";
        height = 36;
        margin-top = 8;
        margin-left = 12;
        margin-right = 12;
        spacing = 8;

        # Layout
        modules-left = [ "hyprland/window" ]; 
        modules-center = [ "cpu" "memory" "hyprland/workspaces" "clock" ]; 
        modules-right = [ "tray" "pulseaudio" "network" "battery" "custom/power" ];

        # DYNAMIC APP ICON MODULE
        "hyprland/window" = {
          # {icon} pulls the actual application icon from your icon theme
          format = "{icon} {title}"; 
          # This ensures it shows the icon even if the window title is empty
          format-icons = {
             "default" = "󱄅"; 
          };
          icon = true;
          icon-size = 18;
          max-length = 35;
          separate-outputs = true;
          # Rewrite rules to clean up titles and ensure specific icons
          rewrite = {
            "(.*) — Mozilla Firefox" = "󰈹 Firefox";
            "(.*) - Dolphin" = "󰉋 Dolphin";
            "(.*) - Visual Studio Code" = "󰨞 VS Code";
            "(.*) - Kitty" = "󰄛 Kitty";
          };
        };

        "hyprland/workspaces" = {
          format = "{icon}";
          on-click = "activate";
          format-icons = {
            "active" = "";
            "default" = "";
            "urgent" = "";
          };
        };

        "cpu" = { format = " {usage}%"; interval = 2; };
        "memory" = { format = " {percentage}%"; interval = 2; };

        "clock" = {
          format = "{:%H:%M - %A, %d/%m}";
          tooltip-format = "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>";
        };

        "pulseaudio" = {
          format = "{icon} {volume}%";
          format-muted = "󰝟";
          format-icons = { default = ["" "" ""]; };
          on-click = "pavucontrol";
        };

        "network" = {
          format-wifi = "";
          format-ethernet = "󰈀";
          format-disconnected = "⚠";
        };

        "battery" = {
          states = { warning = 30; critical = 15; };
          format = "{icon} {capacity}%";
          format-icons = ["" "" "" "" ""];
        };

        "custom/power" = {
          format = "⏻";
          on-click = "wlogout";
          tooltip = false;
        };
      };
    };

    style = ''
* {
  font-family: "JetBrainsMono Nerd Font"; /* Remove fallback to avoid parsing errors */
  font-size: 13px;
  font-weight: bold;
  border: none;
}

      window#waybar {
        background: transparent;
      }

      /* Island Pill Styling */
      #window, #workspaces, #clock, #pulseaudio, #network, #battery, #cpu, #memory, #tray, #custom-power {
        background: rgba(17, 17, 27, 0.7);
        color: #cdd6f4;
        padding: 0 16px;
        margin: 0 4px;
        border-radius: 100px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      /* Specific styling for the Active App Island */
      #window {
        color: #89b4fa;
        background: rgba(30, 30, 46, 0.5);
        padding-left: 10px; /* Space for the icon */
      }

      /* Real-time Workspace highlight */
      #workspaces button {
        color: rgba(137, 180, 250, 0.3);
        padding: 0 4px;
        transition: all 0.3s ease;
      }

      #workspaces button.active {
        color: #89b4fa;
      }

      #workspaces button:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
      }

      #custom-power {
        background: rgba(243, 139, 168, 0.2);
        color: #f38ba8;
      }
    '';
  };
}
